[
  {
    "id": "linux-amd64",
    "runs_on": "ubuntu-22.04",
    "cxx": "g++",
    "cc": "gcc"
  },
  {
    "id": "linux-arm64",
    "runs_on": "ubuntu-24.04-arm",
    "cxx": "g++",
    "cc": "gcc"
  },
  {
    "id": "linux-386",
    "runs_on": "ubuntu-latest",
    "cxx": "g++",
    "cc": "gcc",
    "extra": "-m32",
    "apt": "gcc-multilib g++-multilib"
  },
  {
    "id": "windows-amd64",
    "runs_on": "ubuntu-latest",
    "cxx": "x86_64-w64-mingw32-g++",
    "cc": "x86_64-w64-mingw32-gcc",
    "apt": "mingw-w64"
  },
  {
    "id": "windows-386",
    "runs_on": "ubuntu-latest",
    "cxx": "i686-w64-mingw32-g++",
    "cc": "i686-w64-mingw32-gcc",
    "apt": "mingw-w64"
  },
  {
    "id": "windows-arm64",
    "runs_on": "ubuntu-latest",
    "cxx": "aarch64-w64-mingw32-clang++",
    "cc": "aarch64-w64-mingw32-clang",
    "llvm_mingw": true
  },
  {
    "id": "darwin-amd64",
    "runs_on": "macos-13",
    "cxx": "clang++",
    "cc": "clang"
  },
  {
    "id": "darwin-arm64",
    "runs_on": [
      "self-hosted",
      "macos-m4"
    ],
    "cxx": "clang++",
    "cc": "clang"
  }
]
